{
  "name": "jev-gate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "jev:ping": "tsx --env-file=.env.local scripts/jev-ping.ts",
    "typecheck": "tsc --noEmit",
    "fixtures:check": "tsx scripts/validate-fixtures.ts",
    "typegen": "next typegen",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "eval:record": "tsx --env-file-if-exists=.env.local scripts/eval.ts --mode=record",
    "verify": "npm run typegen && npm run typecheck && npm run test && npm run eval && npm run build"
  },
  "dependencies": {
    "ai": "^7.0.143",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
